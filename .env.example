# Spark 环境变量
# 使用方式：复制本文件为 apps/web/.env.local 并填入真实值
#（apps/web/.env.local 已被 .gitignore 忽略，Next.js 启动时自动加载）

# AI Provider（OpenAI 兼容接口，AI 功能必需；未配置时 AI 功能静默不可用）
AI_API_KEY=
AI_BASE_URL=https://tokens.store/v1
AI_MODEL=deepseek-v4-flash-0731

# MySQL（可选，默认值见 packages/@spark/db/src/index.ts）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=spark123
# MYSQL_DATABASE=spark
